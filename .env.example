# VRM Report - Environment Configuration

# Microsoft Entra ID (Azure AD) App Registration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Microsoft Defender for Endpoint API base URL
# For most tenants: https://api.security.microsoft.com
# For US GCC: https://api-gcc.security.microsoft.us
# For US GCC High: https://api-gcc-high.security.microsoft.us
DEFENDER_API_BASE_URL=https://api.security.microsoft.com

# Report output directory (relative or absolute path)
OUTPUT_DIR=./output

# Enrichment data file path
ENRICHMENT_FILE=./data/enrichment/asset-enrichment.json

# Logging level: error, warn, info, debug
LOG_LEVEL=info
