# VRM Report - Environment Configuration

# Auth mode: "interactive" (device-code browser login) or "client_credential" (app secret)
# Default is interactive — you sign in with your own account via a browser prompt.
AUTH_MODE=interactive

# Microsoft Entra ID (Azure AD) App Registration
AZURE_TENANT_ID=87267a25-654c-4018-ab23-ccda9b419993
AZURE_CLIENT_ID=b30e001b-514f-4928-846f-6f2ddf1fdada
# AZURE_CLIENT_SECRET is only required when AUTH_MODE=client_credential
# AZURE_CLIENT_SECRET=your-client-secret

# Microsoft Defender for Endpoint API base URL
# For most tenants: https://api.securitycenter.microsoft.com
# For US GCC: https://api-gcc.securitycenter.microsoft.us
# For US GCC High: https://api-gcc-high.securitycenter.microsoft.us
DEFENDER_API_BASE_URL=https://api.securitycenter.microsoft.com

# Report output directory (relative or absolute path)
OUTPUT_DIR=./output

# Enrichment data file path
ENRICHMENT_FILE=./data/enrichment/asset-enrichment.json

# Logging level: error, warn, info, debug
LOG_LEVEL=info
